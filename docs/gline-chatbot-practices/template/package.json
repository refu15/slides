{
  "name": "gline-chatbot-llm-template",
  "version": "0.1.0",
  "description": "G-LINE 採用チャットボット向け LLM 切替可能テンプレート。Gemini 3.1 Flash-Lite がデフォルト、週次で自動モデル監視。",
  "private": true,
  "type": "module",
  "scripts": {
    "chat": "tsx scripts/chat-cli.mts",
    "eval": "node scripts/diff-and-eval.mjs",
    "check-models": "node scripts/fetch-models.mjs && node scripts/diff-and-eval.mjs && node scripts/report-slack.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
    "db:init": "psql \"$DATABASE_URL\" -f db/schema.sql && psql \"$DATABASE_URL\" -f db/migrations/0002_rls_policies.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f db/seed.sql",
    "db:smoke": "tsx scripts/smoke-test-db.mts",
    "rag:rebuild": "tsx scripts/rebuild-rag-index.mts",
    "analytics": "tsx scripts/export-analytics.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
