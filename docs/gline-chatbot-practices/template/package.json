{
  "name": "gline-chatbot-llm-template",
  "version": "0.1.0",
  "description": "G-LINE 採用チャットボット向け LLM 切替可能テンプレート。Gemini 3.1 Flash-Lite がデフォルト、週次で自動モデル監視。",
  "private": true,
  "type": "module",
  "scripts": {
    "chat": "tsx scripts/chat-cli.mts",
    "eval": "node scripts/diff-and-eval.mjs",
    "check-models": "node scripts/fetch-models.mjs && node scripts/diff-and-eval.mjs && node scripts/report-slack.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "rag:build": "tsx scripts/build-rag-chunks.mts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
