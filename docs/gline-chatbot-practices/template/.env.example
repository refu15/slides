# ============================================================
# LLM プロバイダ
# ============================================================
GEMINI_API_KEY=AIzaSy...

# フォールバック先（任意）
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# Neon PostgreSQL
# ============================================================
# 形式: postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require
# 東京リージョン: ap-northeast-1
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx-xxx.ap-northeast-1.aws.neon.tech/gline_chatbot?sslmode=require

# 応募者個人情報の暗号化キー（32 bytes 推奨, pgcrypto pgp_sym_encrypt 用）
# 本番では Cloud KMS / Doppler / 1Password CLI 等で管理
APPLICANT_ENC_KEY=change-me-to-a-long-random-string-min-32-bytes

# セッションID ハッシュ化のソルト
SESSION_SALT=gline-salt-change-me

# ============================================================
# 通知
# ============================================================
# Slack Webhook（週次 LLM モデル監視レポート用）
SLACK_WEBHOOK=https://hooks.slack.com/services/...

# Resend（info メール通知用、無料 3000通/月）
RESEND_API_KEY=re_...
NOTIFY_EMAIL=info@example.com
