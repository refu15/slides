# ============================================================
# LLM プロバイダ
# ============================================================
GEMINI_API_KEY=AIzaSy...

# フォールバック先（任意）
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# PostgreSQL（AWS RDS 東京 ap-northeast-1）
# ============================================================
# 形式: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
# AWS RDS エンドポイント例:
#   gline-db.xxxxxx.ap-northeast-1.rds.amazonaws.com
DATABASE_URL=postgresql://gline_app:PASSWORD@gline-db.xxxxxx.ap-northeast-1.rds.amazonaws.com:5432/gline_chatbot?sslmode=require

# Cloudflare Workers 経由で接続する場合は Hyperdrive binding を使用
# （wrangler.toml で設定。ローカル開発時は上の DATABASE_URL を使用）

# 応募者個人情報の暗号化キー（32 bytes 推奨, pgcrypto pgp_sym_encrypt 用）
# 本番では AWS Secrets Manager / Doppler / 1Password CLI 等で管理
APPLICANT_ENC_KEY=change-me-to-a-long-random-string-min-32-bytes

# セッションID ハッシュ化のソルト
SESSION_SALT=gline-salt-change-me

# ============================================================
# 通知
# ============================================================
# Slack Webhook（週次 LLM モデル監視レポート / 障害通知）
SLACK_WEBHOOK=https://hooks.slack.com/services/...

# Resend（info メール通知用、無料 3000通/月）
RESEND_API_KEY=re_...
NOTIFY_EMAIL=info@g-line.co.jp

# ============================================================
# Cloudflare（Workers デプロイ時に使用）
# ============================================================
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_API_TOKEN=...
