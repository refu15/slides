{
  "name": "gline-chatbot-api",
  "version": "0.1.0",
  "description": "G-LINE 採用チャットボット API (Cloudflare Workers + Hyperdrive + AWS RDS)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit"
