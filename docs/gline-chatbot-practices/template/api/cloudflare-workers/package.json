  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^25.6.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
